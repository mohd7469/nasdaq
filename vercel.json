{
    "rewrites": [
        {
            "source": "/:folder/api",
            "destination": "/api/index"
        },
        {
            "source": "/:folder/api/",
            "destination": "/api/index"
        },
        {
            "source": "/:folder/api/:path*",
            "destination": "/api/:path*"
        }
    ]
}